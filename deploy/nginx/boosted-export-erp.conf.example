# Nginx example, replace domains/certificate paths/runtime pool.
# Point document root at backend/public ONLY. Do not expose .env or source.
limit_req_zone $binary_remote_addr zone=expo_login:10m rate=12r/m;

server {
    listen 80;
    server_name export.example.com;
    return 308 https://export.example.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name export.example.com;
    root /srv/boosted-export-erp/backend/public;
    index index.php;
    charset utf-8;
    server_tokens off;
    client_max_body_size 12m;
    ssl_certificate /etc/letsencrypt/live/export.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/export.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    # Laravel sets route-specific Referrer-Policy, including no-referrer on
    # bearer-token buyer URLs. Do not override it with a conflicting header.

    # The Laravel /up endpoint is liveness only. Use private expo:preflight
    # and expo:monitor for database/cache/recent-backup readiness.
    location = /up {
        try_files $uri /index.php?$query_string;
    }

    location = /login {
        limit_req zone=expo_login burst=5 nodelay;
        try_files $uri /index.php?$query_string;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Assets contain no secrets and can be cached; HTML stays private.
    location ~* ^/(?:assets|build)/.*\.(?:js|css|svg|webp|png|jpg|woff2)$ {
        access_log off;
        expires 7d;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location ~ ^/(?:storage|vendor|config|app|bootstrap|database|tests|\.git)/ {
        deny all;
    }
    location ~ /\. {
        deny all;
    }
    # Only Laravel's checked front controller is executable. Never let an
    # accidentally uploaded PHP file under public/ become a script endpoint.
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root/index.php;
        fastcgi_param HTTPS on;
        fastcgi_param HTTP_HOST $host;
        fastcgi_read_timeout 60s;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
    }
    location ~ \.php$ {
        return 404;
    }
}
