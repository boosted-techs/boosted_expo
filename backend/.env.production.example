# Boosted Export ERP — production TEMPLATE. Never put real credentials into Git.
# Make a PRIVATE server copy: cp .env.production.example .env
# chmod 600 .env; chown ERP_RUNTIME_USER .env
# Use dedicated secret manager to inject credentials, rotated independently.
APP_NAME="Boosted Export ERP"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://export.example.com
APP_KEY=
APP_TIMEZONE=UTC
APP_LOCALE=en
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# Dedicated PostgreSQL, restricted owner/app and TLS verified against CA.
# Do not migrate your existing SQLite into this database without a rehearsed
# data migration and counts/foreign-key reconciliation.
DB_CONNECTION=pgsql
DB_HOST=postgres.example.internal
DB_PORT=5432
DB_DATABASE=boosted_export
DB_USERNAME=boosted_export_app
DB_PASSWORD=
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/ssl/certs/your-postgres-ca.pem

# Redis TLS/ACL recommended; NEVER expose Redis to the public Internet.
# predis/predis installed as the PHP client; no phpredis extension required.
REDIS_CLIENT=predis
REDIS_SCHEME=tls
REDIS_SSL_CA=/etc/ssl/certs/your-redis-ca.pem
REDIS_HOST=redis.example.internal
REDIS_PORT=6380
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=boosted_export_erp_prod_
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

# Verified corporate SMTP with TLS required. STARTTLS on 587 is a suitable
# example; check provider docs before release. Do not use MAIL_MAILER=log.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=notifications@example.com
MAIL_FROM_NAME="Boosted Export ERP"

# Private Cloudflare R2 (product images), separate from application files.
FILESYSTEM_DISK=local
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=boosted-export-private
R2_ENDPOINT=https://CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com

# Only supply load balancer / reverse-proxy IPs you control; leave blank if
# PHP-FPM receives correct HTTPS from Nginx directly. Never use "*".
TRUSTED_PROXIES=

# libsodium key: php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
# Store backup decryption key in external escrow independent of APP_KEY.
EXPO_BACKUP_KEY_BASE64=
EXPO_BACKUP_DIR=/var/backups/boosted-export-erp
EXPO_BACKUP_MAX_AGE_HOURS=26
# Dedicated separate bucket/account, restrict credentials to archives prefix.
# Offsite lifecycle/immutability & legal retention must be configured at provider.
EXPO_BACKUP_OFFSITE_ENABLED=true
EXPO_BACKUP_OFFSITE_ACCESS_KEY_ID=
EXPO_BACKUP_OFFSITE_SECRET_ACCESS_KEY=
EXPO_BACKUP_OFFSITE_BUCKET=boosted-export-disaster-recovery
EXPO_BACKUP_OFFSITE_ENDPOINT=https://CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
EXPO_BACKUP_OFFSITE_PREFIX=encrypted-backups
EXPO_BACKUP_SCHEDULE_ENABLED=true
EXPO_MONITOR_SCHEDULE_ENABLED=true
EXPO_MIN_FREE_DISK_GB=5
EXPO_OPS_ALERT_WEBHOOK_URL=

# Official bank signing keys are an external phase-3 dependency, not a
# requirement for platform TLS or backups. Never put private bank keys here.
FINANCE_TRUSTED_BANK_ISSUERS_JSON={}
